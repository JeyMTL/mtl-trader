# Copy to .env and fill in your own practice token from
# OANDA -> My Account -> Manage API Access. Never commit .env.
OANDA_API_TOKEN=your-oanda-practice-token

# Practice host by default. Real orders need the live host AND BOT_ALLOW_LIVE=true.
OANDA_API_BASE=https://api-fxpractice.oanda.com
# OANDA_API_BASE=https://api-fxtrade.oanda.com

# Optional defaults for the CLI.
BOT_INSTRUMENT=EUR_USD
BOT_GRANULARITY=M5
BOT_BALANCE=10000
BOT_RISK_PCT=0.01
BOT_LEVERAGE=30
BOT_SLIPPAGE_PIPS=0.2

# Leave false. Setting this true is the only way the bot will trade a live account.
BOT_ALLOW_LIVE=false
