{
  "name": "mtl-trader-mobile",
  "private": true,
  "version": "1.0.0",
  "description": "Mobile app for the MTL Trader journal (loads the live Vercel app)",
  "scripts": {
    "add:android": "cap add android",
    "add:ios": "cap add ios",
    "sync:android": "cap sync android",
    "sync:ios": "cap sync ios",
    "open:android": "cap open android",
    "open:ios": "cap open ios",
    "copy:android": "cap copy android",
    "copy:ios": "cap copy ios",
    "build:android": "cap sync android && cap open android",
    "build:ios": "cap sync ios && cap open ios"
  },
  "devDependencies": {
    "@capacitor/android": "^7.4.4",
    "@capacitor/cli": "^7.4.4",
    "@capacitor/ios": "^7.4.4"
  },
  "dependencies": {
    "@capacitor/core": "^7.4.4",
    "@capacitor/splash-screen": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0",
    "@capacitor/keyboard": "^7.0.0",
    "@capacitor/haptics": "^7.0.0",
    "@capacitor/app": "^7.0.0"
  }
}
