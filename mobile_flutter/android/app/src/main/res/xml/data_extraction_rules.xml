<?xml version="1.0" encoding="utf-8"?>
<!--
  The Supabase session (access and refresh token) lives in SharedPreferences.
  Cloud backup and device-to-device transfer would copy it off the phone, so both
  are excluded. `allowBackup="false"` already covers API 30 and below; this file
  is what Android 12+ reads.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
    </device-transfer>
</data-extraction-rules>
