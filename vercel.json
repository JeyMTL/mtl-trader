{
  "crons": [
    {
      "path": "/api/admin/reconcile",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/notifications",
      "schedule": "0 18 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.mtlledger.com" }],
      "destination": "https://mtlledger.com/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "mtl-trader.vercel.app" }],
      "destination": "https://mtlledger.com/$1",
      "permanent": true
    }
  ]
}
