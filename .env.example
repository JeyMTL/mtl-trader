# ---------------------------------------------------------------------------
# MTL Trader environment variables
#
# Copy to `.env.local` and fill in real values. Placeholders only — never commit
# real secrets. Variables marked "required" must be set or that feature is off.
# ---------------------------------------------------------------------------

# Supabase (required for auth and database)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Alternatively, use the newer Supabase publishable key name.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Server-only key used by API routes and the notification cron (bypasses RLS).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App
NEXT_PUBLIC_APP_URL

# Optional: receive unhandled request errors as JSON POSTs (error tracker, Slack
# webhook, etc.). Without it every error is still emitted as a structured log line.
# ERROR_REPORT_URL=https://example.com/errors

# PayPal (required for payments)
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
# Defaults to the live API. Use the sandbox for testing:
# PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# Required to verify webhook signatures; without it the webhook fallback is disabled.
PAYPAL_WEBHOOK_ID=your-webhook-id

# Flutterwave card subscriptions (optional; without these the card checkout is off)
# Secret key from the Flutterwave dashboard (Settings → API keys).
FLUTTERWAVE_SECRET_KEY=FLWSECK-your-secret-key
# The webhook secret hash from Settings → Webhooks. The endpoint is
# https://your-domain/api/webhooks/flutterwave
FLUTTERWAVE_SECRET_HASH=your-webhook-secret-hash
# Defaults to the live API. Use the sandbox for testing:
# FLUTTERWAVE_API_BASE=https://developersandbox-api.flutterwave.com
# Payment plans and charges are created in this currency (default USD).
# FLUTTERWAVE_CURRENCY=USD

# Paddle card subscriptions (optional; without these the card checkout is off)
# Paddle is the merchant of record, so it handles sales tax and receipts.
# API key from Paddle → Developer tools → Authentication (starts with pdl_live_ or pdl_sdbx_).
PADDLE_API_KEY=pdl_sdbx_your-api-key
# Notification destination secret (Paddle → Developer tools → Notifications).
# Endpoint URL: https://your-domain/api/webhooks/paddle
PADDLE_WEBHOOK_SECRET=pdl_ntfset_your-notification-secret
# Price ids for the paid plans (Paddle → Catalogue → Products → Prices, pri_…).
# A plan with no price id cannot be bought and its button is hidden.
PADDLE_PRICE_BASIC=pri_your_basic_monthly_price
PADDLE_PRICE_PRO=pri_your_pro_monthly_price
# Yearly prices ($120 and $290). Separate catalogue entries, so either cadence
# can be omitted: with no annual id the pricing page shows no annual option.
PADDLE_PRICE_BASIC_ANNUAL=pri_your_basic_annual_price
PADDLE_PRICE_PRO_ANNUAL=pri_your_pro_annual_price
# Sandbox by default. Set to production once the sandbox flow is proven:
# PADDLE_ENVIRONMENT=production
# Charged currency. Must match the currency of the price ids above (default USD).
# PADDLE_CURRENCY=USD

# Hosted broker sync (required for "connect automatically" from the phone)
# 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Seals each connected account's investor (read-only) password before it is
# stored. Rotating it makes every stored credential undecryptable, so customers
# must reconnect — rotate deliberately, never casually.
SYNC_CREDENTIAL_KEY=
# Shared secret the hosted sync supervisor uses to post trades for any customer
# it holds a connection for. Server-side only; never shipped to a client.
SYNC_SUPERVISOR_TOKEN=

# Market data for the mobile chart (required for candles; without a token the
# route answers 503). The chart calls /api/market/candles, which proxies OANDA so
# no credential ever ships in the app.
#
# OANDA v20 is the only provider: forex, metals, indices and energy as CFDs, plus
# BTC/ETH. Create a token in the account's Manage API Access page — a practice
# token is enough locally.
OANDA_API_TOKEN=your-oanda-api-token
# Defaults to the practice host. Live accounts: https://api-fxtrade.oanda.com
# OANDA_API_BASE=https://api-fxpractice.oanda.com

# Email notifications via Resend (optional; without these the cron no-ops)
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=MTL Trader <reports@yourdomain.com>
# Shared secret Vercel Cron sends as `Authorization: Bearer <value>`. Required by
# both /api/cron/notifications and /api/admin/reconcile; the crons fail closed without it.
CRON_SECRET=your-random-cron-secret

# AI journal review (optional server-side; without a key the review returns 503)
# Provider selection: openai | anthropic | gemini | openai-compatible. Inferred
# from the keys when AI_PROVIDER is unset (paid keys preferred, Gemini last).
#
# Zero-cost path: a Google AI Studio key needs no card and has a free tier, and
# Gemini speaks the OpenAI-compatible protocol. Precedence is explicit
# AI_PROVIDER, then OPENAI_API_KEY, then ANTHROPIC_API_KEY, then GEMINI_API_KEY.
# So this one variable is enough to run the review for free:
GEMINI_API_KEY=your-ai-studio-key
# Pinned default is gemini-3.6-flash: newer flash models were returning 503
# "high demand" or hanging on the compatibility layer. Override when healthy.
# GEMINI_MODEL=gemini-3.6-flash
# Free-tier quotas are per key and per minute: fine for early users, not for a
# burst. Move to a paid key when the review is used daily.

OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=your-anthropic-api-key
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest
# AI_PROVIDER=openai-compatible
# AI_BASE_URL=https://your-gateway.example.com/v1
# AI_API_KEY=your-gateway-key
# Overrides applied to whichever provider is selected:
# AI_MODEL=gpt-4o-mini
# AI_VISION_MODEL=gpt-4o-mini

# Bank transfer details (optional; served by /api/bank-details)
BANK_NAME=Your Bank
BANK_ACCOUNT_NAME=Your Account Name
BANK_ACCOUNT_NUMBER=0000000000
BANK_BRANCH=Your Branch
