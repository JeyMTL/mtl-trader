# Supervisor settings for a single 2 vCPU / 2 GB Windows Server host.
#
# Copy this over C:\MTLSync\.env and fill in the four secrets. Everything else is
# already tuned for 2 GB of RAM: FLEET_SIZE stays 0 because one terminal is
# ~140 MB and Windows Server needs ~1.2 GB, so there is no room for a second
# slot. The account the supervisor is watching is still journaled within
# WATCH_SECONDS; everyone else is re-read on the rotation below.

# --- identity ---------------------------------------------------------------
SUPABASE_URL=https://oknrivipgpptsebeyvsq.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Must match the web app exactly. Rotating SYNC_CREDENTIAL_KEY makes every
# stored broker credential undecryptable.
SYNC_CREDENTIAL_KEY=
SYNC_SUPERVISOR_TOKEN=

# --- where the app is -------------------------------------------------------
# The VPS does not run Next.js; it talks to production over HTTPS.
APP_URL=https://mtlledger.com

# --- the terminal -----------------------------------------------------------
# A portable copy of the terminal, NOT the one under Program Files: portable
# mode keeps accounts, history and common.ini inside C:\MT5-Sync, which is also
# the only place the supervisor can write [Experts] AllowLiveTrading for the
# daily-stop lock without a click.
MT5_PATH=C:\MT5-Sync\terminal64.exe
MT5_PORTABLE=1

# --- capacity ---------------------------------------------------------------
# Sequential mode. 2 GB cannot hold fleet slots (each is ~140 MB on top of
# Windows), so one session is shared by taking turns.
FLEET_SIZE=0

# Claim new work every 30s instead of 15s: a sign-in lands a few seconds later,
# and the claim request itself is one constant query either way.
CYCLE_SECONDS=30

# Re-read a connected account every 3 minutes. This is the number that scales
# with customers on a small host; 60s is fine on 8 GB, not here.
REFRESH_SECONDS=180

# With exactly one connected account the supervisor stays logged in and polls
# this often, so that account's close is journaled in about 2 seconds.
WATCH_SECONDS=2

# Ceiling on accounts worked per cycle, so one cycle cannot run for minutes on a
# small box. Least recently synced accounts are served first, so nobody starves.
MAX_ACCOUNTS=6

# First sync waits for the terminal to download history before it stores a
# cursor. 90s covers a fresh install on a slow link.
HISTORY_WAIT_SECONDS=90

# --- daily stop -------------------------------------------------------------
# Ask /api/ea/lock while a session is open and pull resting orders once the day
# is over. Needs a master password to cancel; with an investor password MT5
# answers 10017 and the log says so once.
ENFORCE_LOCK=1
LOCK_POLL_SECONDS=30

# --- retries ----------------------------------------------------------------
# A rejected password or an unresolved server is not retried for 15 minutes,
# which keeps the single session free for accounts that can connect.
FAILED_RETRY_SECONDS=900

# --- one host ---------------------------------------------------------------
# Leave these alone until a second supervisor exists. Every host must agree on
# SUPERVISOR_SHARDS at the same moment.
SUPERVISOR_SHARDS=1
SUPERVISOR_SHARD=0
