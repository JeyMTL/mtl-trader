# Copy to supervisor/.env and fill in. This file is gitignored.
# Real environment variables override these values.

# Supabase project. Use the same URL as NEXT_PUBLIC_SUPABASE_URL.
SUPABASE_URL=https://your-project.supabase.co
# Service-role key from Project Settings -> API. Server-side only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Both must match the web app's .env.local exactly.
# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SYNC_CREDENTIAL_KEY=
# Random shared secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SYNC_SUPERVISOR_TOKEN=

# Where the Next app is running. localhost is correct when the supervisor runs
# on the same PC as the app.
APP_URL=http://127.0.0.1:3000

# The separate terminal, copied out of Program Files. Portable mode keeps its
# accounts and history inside that folder instead of sharing %APPDATA% with the
# terminal you trade on.
MT5_PATH=C:\MT5-Sync\terminal64.exe
MT5_PORTABLE=1
# More terminals, comma or semicolon separated, tried in order when a login
# fails on the first. This is how a prop-firm account works on a host whose
# plain MetaQuotes terminal cannot resolve that firm's server: point one entry at
# the terminal the firm gave you. Any terminal installed under Program Files is
# found automatically, so this is only needed for an install elsewhere.
MT5_PATHS=C:\Program Files\FundedNext MT5\terminal64.exe

# Fleet mode: keep a terminal open per account so several accounts are journaled
# within seconds of a close, instead of taking turns on one session. Each slot is
# a separate terminal directory and a separate worker process. 0 keeps the
# sequential mode. Prepare the slots with:
#   powershell -ExecutionPolicy Bypass -File supervisor/setup_fleet.ps1 -Count 30
# and paste what it prints below. ~140 MB and ~2.5% of one core per slot, so a
# 4 vCPU / 8 GB host holds about 30.
FLEET_SIZE=0
# One directory (or terminal64.exe) per slot, comma or semicolon separated.
MT5_FLEET_DIRS=
# A slot keeps watching its account until it disconnects. If every slot is taken
# and another account is waiting, a slot that has held at least this long hands
# its account back, so a full fleet rotates instead of parking the newest
# sign-in forever.
FLEET_MIN_HOLD_SECONDS=60

# Pacing. 15s makes a phone connect feel immediate; the claim query is a
# constant cost regardless of how many accounts exist. Raise it if the
# supervisor host is very small.
CYCLE_SECONDS=15
# How often a connected account is re-read when several are connected.
REFRESH_SECONDS=60
# With exactly one connected account the supervisor stays logged in and polls
# this often, so a close is journaled in about this many seconds. 0 disables.
WATCH_SECONDS=2

# Running more than one supervisor host against this project. The claim is a
# plain GET, so every host would otherwise see every pending account and sync
# it twice. Set the same SUPERVISOR_SHARDS everywhere and a different
# SUPERVISOR_SHARD per host (0-based); ownership is a hash of user_id, so no
# column or assignment table is needed. Leave both alone for a single host.
SUPERVISOR_SHARDS=1
SUPERVISOR_SHARD=0

# The most accounts this host works on per cycle. A brake for a small host, not
# a load balancer: 0 means no cap. When the cap is hit the least recently synced
# accounts are served first, so a backlog rotates instead of starving.
MAX_ACCOUNTS=0
