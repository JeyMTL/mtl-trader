# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# local editor tooling
.kilo/

# local SDK downloads used for verification
.tooling/

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*

# Private MT5 account reports
ReportHistory-*.xlsx
ReportHistory-*.xml
*.xls
*.xlsx

# Local broker exports (personal financial data — never commit)
trade_data.json
trades_clean.csv
ReportHistory-*.json

# One-off MT5 → JSON converter, kept on disk for personal use only
/convert.js

# Ship the example env file (placeholders only) despite the .env* rule above
!.env.example

# IDE / editor
.idea/*
# Flutter run configurations are shared so the play button works on a fresh clone
!**/.idea/runConfigurations/

# Android local + build output (machine-specific SDK path, Gradle builds)
mobile/android/local.properties
mobile/android/app/build/
mobile/android/build/
mobile/android/capacitor-cordova-android-plugins/build/

# Signing material. A keystore plus its password is total control of the app's
# updates, so it must never enter git from any folder — mobile_flutter/ has its
# own copy of these rules; this covers the legacy mobile/ shell and anything new.
*.jks
*.keystore
key.properties

# Rendered store assets keep a throwaway Chrome profile
store/.chrome-profile/
